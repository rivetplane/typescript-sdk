{
  "name": "@rivetplane/sdk",
  "version": "0.2.0",
  "description": "First-party TypeScript SDK for the Rivetplane control-plane API",
  "keywords": [
    "rivetplane",
    "agent",
    "harness",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/*.test.*",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rivetplane/typescript-sdk.git"
  },
  "homepage": "https://github.com/rivetplane/typescript-sdk#readme",
  "bugs": {
    "url": "https://github.com/rivetplane/typescript-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf dist",
    "prepare": "npm run build",
    "prepack": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit --composite false",
    "test": "npm run build && node --test dist/*.test.js",
    "browser:check": "esbuild src/index.ts --bundle --platform=browser --format=esm --outfile=dist/browser-check.js",
    "package:verify": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2"
  }
}
